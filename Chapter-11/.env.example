# Copy to .env.local and fill in credentials before running analyst_agent.py.
# Deterministic tests and direct stock_server.py checks do not require credentials.

# Gemini API key path.
GOOGLE_GENAI_USE_VERTEXAI=0
GOOGLE_API_KEY=

# Vertex AI path. Set GOOGLE_GENAI_USE_VERTEXAI=1 when using these values.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Model used by analyst_agent.py.
CH11_MODEL=gemini-3.5-flash
