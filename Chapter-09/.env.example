# Copy to .env.local and fill in credentials before running the model-backed
# ADK/Gemini examples.

# Gemini API key path.
GOOGLE_GENAI_USE_VERTEXAI=0
GOOGLE_API_KEY=

# Vertex AI path. Set GOOGLE_GENAI_USE_VERTEXAI=1 when using these values.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Chapter 9 service ports.
CH9_GREETER_HOST=127.0.0.1
CH9_GREETER_PORT=10000
CH9_MATH_HOST=127.0.0.1
CH9_MATH_PORT=10001
CH9_QUERY_GENERATOR_HOST=127.0.0.1
CH9_QUERY_GENERATOR_PORT=10002
CH9_RESEARCHER_HOST=127.0.0.1
CH9_RESEARCHER_PORT=10003

# Model used by the ADK agents and Gemini text calls.
CH9_MODEL=gemini-2.5-flash

# Optional local smoke-test mode. Set to 1 to exercise the A2A routes without
# Google credentials by replacing model calls with deterministic local text.
CH9_DETERMINISTIC_SMOKE=0
