GOOGLE_API_KEY=your_google_api_key_here

# Gemini Live defaults.
AGENT_SYSTEM_LIVE_MODEL=gemini-3.1-flash-live-preview
AGENT_SYSTEM_FALLBACK_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
AGENT_SYSTEM_STOCK_AGENT_MODEL=gemini-2.5-flash
AGENT_SYSTEM_WEATHER_AGENT_MODEL=gemini-2.5-flash

# Local service endpoints.
AGENT_SYSTEM_MCP_HOST=127.0.0.1
AGENT_SYSTEM_MCP_PORT=8010
AGENT_SYSTEM_MCP_URL=http://127.0.0.1:8010/mcp
AGENT_SYSTEM_A2A_HOST=127.0.0.1
AGENT_SYSTEM_A2A_PORT=8020
AGENT_SYSTEM_A2A_URL=http://127.0.0.1:8020
AGENT_SYSTEM_WEATHER_A2A_HOST=127.0.0.1
AGENT_SYSTEM_WEATHER_A2A_PORT=8030
AGENT_SYSTEM_WEATHER_A2A_URL=http://127.0.0.1:8030
AGENT_SYSTEM_SPECIALIST_AGENT_URLS=http://127.0.0.1:8020,http://127.0.0.1:8030
AGENT_SYSTEM_BACKEND_HOST=127.0.0.1
AGENT_SYSTEM_BACKEND_PORT=8000
AGENT_SYSTEM_FRONTEND_HOST=127.0.0.1
AGENT_SYSTEM_FRONTEND_PORT=8080
AGENT_SYSTEM_LIVE_WS_URL=ws://127.0.0.1:8000/live
AGENT_SYSTEM_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
