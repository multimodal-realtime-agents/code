# General Configuration
# Set to 0 to use Google AI Studio (API Key)
# Set to 1 to use Vertex AI (Google Cloud Project)
GOOGLE_GENAI_USE_VERTEXAI=1

# Model Configuration
# Common models: gemini-2.5-flash, gemini-2.0-flash-exp, gemini-1.5-flash
MODEL=gemini-2.5-flash

# --- Option A: Google AI Studio (API Key) ---
# Required if GOOGLE_GENAI_USE_VERTEXAI=0
GOOGLE_API_KEY=YOUR_API_KEY_HERE

# Live Model Configuration if GOOGLE_GENAI_USE_VERTEXAI=0
#MODEL_LIVE_API=gemini-2.5-flash-preview-native-audio-dialog #gemini-2.0-flash-live-001, gemini-live-2.5-flash-preview, gemini-2.5-flash-native-audio-preview-09-2025, gemini-2.5-flash-preview-native-audio-dialog, gemini-2.5-flash-exp-native-audio-thinking-dialog


# --- Option B: Vertex AI (Google Cloud) ---
# Required if GOOGLE_GENAI_USE_VERTEXAI=1
GOOGLE_CLOUD_PROJECT=YOUR_PROJECT_ID
GOOGLE_CLOUD_LOCATION=us-central1

# Live Model Configuration if GOOGLE_GENAI_USE_VERTEXAI=1
MODEL_LIVE_VERTEX=gemini-live-2.5-flash-native-audio #gemini-live-2.5-flash-native-audio # gemini-live-2.5-flash-preview-native-audio, gemini-live-2.5-flash-preview-native-audio-09-17
